module org.xtext.lua.GenerateLua

import org.eclipse.emf.mwe.utils.StandaloneSetup
import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = "./org.xtext.lua"

Workflow {
	bean = StandaloneSetup {
        scanClassPath = true
        platformUri = rootPath
    }
    
	component = XtextGenerator {
		configuration = {
			project = StandardProjectConfig {
				baseName = "org.xtext.lua"
				rootPath = rootPath
				runtime = {
					root = rootPath
                    ecoreModel = "${rootPath}/src/main/generated"
                    src = "${rootPath}/src/main/java"
                    srcGen = "${rootPath}/src/main/generated"
				}
				runtimeTest = {
					enabled = true
					root = rootPath
                    src = "${rootPath}/src/test/java"
                    srcGen = "${rootPath}/src/test/generated"
				}
				eclipsePlugin = {
					enabled = false
				}
				eclipsePluginTest = {
					enabled = false
				}
				createEclipseMetaData = true
			}
			code = {
				encoding = "UTF-8"
				lineDelimiter = "\n"
				fileHeader = "/*\n * generated by Xtext \${version}\n */"
				preferXtendStubs = false
			}
		}
		language = StandardLanguage {
			name = "org.xtext.lua.Lua"
			
			fileExtensions = "lua"
			
			grammarUri = "platform:/resource/org.xtext.lua/src/main/xtext/Lua.xtext"
			
			// from https://github.com/eclipse/xtext-core/issues/1518
			parserGenerator = parser.antlr.XtextAntlrGeneratorFragment2 {
  				options = {
  					// TODO en/disable
  					backtrack = false
//  					backtrack = true
  				}
//  			// from https://blogs.itemis.com/en/debugging-xtext-grammars-what-to-do-when-your-language-is-ambiguous
//				debugGrammar = true
      		}

			validator = {
				generateXtendStub = false
				// Generates checks for @Deprecated grammar annotations, an IssueProvider and a corresponding PropertyPage
				generateDeprecationValidation = true
			}

			junitSupport = {
				junitVersion = "5"
			}
			
			// serialization for EMF
			resourceFactoryFragment = resourceFactory.ResourceFactoryFragment2 { }
			
			xbaseSupport = null
			xtypeSupport = null
		}
	}
}
